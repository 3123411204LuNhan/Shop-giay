{
  "name": "sole-studio-nhom19",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node frontend/scripts/start-system.js",
    "build": "vite build frontend",
    "start": "node frontend/scripts/start-system.js --production",
    "db:setup": "node frontend/scripts/start-system.js --db-setup",
    "db:seed": "node frontend/scripts/start-system.js --db-seed",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:integration": "node frontend/scripts/start-system.js --test-integration",
    "check": "node --check frontend/scripts/start-system.js && node --check frontend/scripts/test-integration.js && dotnet build backend/ShopGiay.Api",
    "db:migrate": "node frontend/scripts/start-system.js --db-migrate",
    "mail:verify": "node frontend/scripts/start-system.js --verify-mail"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  }
}
